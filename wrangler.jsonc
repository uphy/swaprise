{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "swaprise",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "routes": [
    {
      "pattern": "swaprise.uphy.dev",
      "custom_domain": true
    }
  ],
  "main": "worker/index.ts",
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "Room"
      },
      {
        "name": "COORDINATOR",
        "class_name": "Coordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Room",
        "Coordinator"
      ]
    }
  ],
  "vars": {
    "ONLINE_ENABLED": "true"
  }
}
